# Protean environment template — copy to `.env` and fill in, OR (preferred) export directly /
# use `hud set HUD_API_KEY=...`. Do NOT commit a real `.env`. Nothing here is needed to run the
# test suite or the deterministic/bandit optimizer; secrets are only for the features noted.

# --- Secrets (only for the feature that uses them) ---
# HUD eval / trial streaming / deploy (redeem with sponsor code YC-RL-HACKATHON):
HUD_API_KEY=
# Fireworks edit policy only (--edit-policy fireworks); redeem with HUD-HACK-2026:
FIREWORKS_API_KEY=

# --- GPU / runtime ---
# Triton JIT compile cache (kills 30-120s cold start); baked to /triton-cache in Dockerfile.hud:
TRITON_CACHE_DIR=/triton-cache
# HUD env workspace path (default /workdir on image, per-pid tmp locally):
# WORKSPACE_ROOT=/workdir

# --- Optional tuning (all have safe defaults) ---
# PROTEAN_MAX_STEPS=150          # GRPO training steps
# PROTEAN_LOG=1                  # enable structured JSON logging
# PROTEAN_DISABLE_VLLM=1         # disable vLLM on hosts without it
# PROTEAN_SKIP_CALIBRATION=1     # skip the pre-GRPO go/no-go gate
# PROTEAN_SMOKE_TEST=1           # tiny smoke run
# PROTEAN_OUTPUT_DIR=runs/...    # override output dir
# PROTEAN_ALLOW_DYNAMIC_MANIFEST=1  # allow on-the-fly manifest vs the frozen one
