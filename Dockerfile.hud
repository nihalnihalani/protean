FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TRITON_CACHE_DIR=/triton-cache
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
ENV TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9;9.0"

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3.11-dev python3-pip git util-linux && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /triton-cache && chmod 777 /triton-cache

WORKDIR /app

# Initialize virtualenv and upgrade pip
RUN python3.11 -m venv /opt/venv && \
    python -m pip install --no-cache-dir --upgrade pip

# Cache layer: Install vllm first (since it's heavy and drags torch with it)
RUN python -m pip install --no-cache-dir vllm==0.6.3

# Cache layer: Copy requirements-train.txt and install the rest of the RL training stack
COPY requirements-train.txt /app/requirements-train.txt
RUN python -m pip install --no-cache-dir -r /app/requirements-train.txt

# trl 0.15.2 hard-imports mergekit in callbacks.py unconditionally (despite having
# an is_mergekit_available() guard — it's a bug). We never use ModelMergeCallback,
# so install a minimal stub package that satisfies the one import trl needs:
#   mergekit.config.MergeConfiguration
# Stub approach is safe from stale .pyc issues that affect sed-based patching.
RUN python3 -c "
import os, sys
base = '/opt/venv/lib/python3.11/site-packages/mergekit'
os.makedirs(base, exist_ok=True)
# __init__.py
open(os.path.join(base, '__init__.py'), 'w').close()
# config.py — only symbol trl/mergekit_utils.py imports at module level
with open(os.path.join(base, 'config.py'), 'w') as f:
    f.write('class MergeConfiguration:\n    pass\n')
print('mergekit stub installed at', base)
sys.stdout.flush()
" && \
    python3 -c "from mergekit.config import MergeConfiguration; print('mergekit stub import OK')"

# Cache layer: Install HUD SDK
RUN python -m pip install --no-cache-dir "hud-python[agents]==0.6.6"

# Now copy the rest of the project source code
COPY . /app

# Install the project packages in editable mode
RUN python -m pip install --no-cache-dir -e ".[gpu]" && \
    python -m pip install --no-cache-dir -e . --no-deps

# Build-time import smoke check
RUN python -c "import torch, trl, vllm, peft; print(f'torch={torch.__version__} trl={trl.__version__} vllm={vllm.__version__} peft={peft.__version__}'); assert torch.cuda.is_available() or True, 'CUDA check deferred to runtime'"

RUN useradd -m -u 1000 agent

# Bake reward-code integrity into hidden graders and training calibration.
RUN REWARDS_SHA="$(sha256sum /app/src/protean/rewards.py | awk '{print $1}')" && \
    find /app/src/protean/tasks -path '*/donotaccess/grade.py' -type f \
        -exec sed -i "s|<sha256 baked at image build>|${REWARDS_SHA}|g" {} + && \
    sed -i "s|<sha256 baked at image build>|${REWARDS_SHA}|g" /app/train/calibrate.py && \
    echo "Baked REWARDS_HASH=${REWARDS_SHA}"

# Canonical hidden verifier moat. HUD agents run as uid 1000 and cannot read it.
RUN mkdir -p /donotaccess && \
    cp /app/src/protean/rewards.py /donotaccess/rewards.py && \
    cp /app/src/protean/reward_config.json /donotaccess/reward_config.json && \
    for opdir in /app/src/protean/tasks/*/donotaccess; do \
        op="$(basename "$(dirname "$opdir")")"; \
        mkdir -p "/donotaccess/$op"; \
        cp "$opdir/grade.py" "/donotaccess/$op/grade.py"; \
        cp "$opdir/reference.py" "/donotaccess/$op/reference.py"; \
    done && \
    chown -R root:root /donotaccess && \
    chmod -R 700 /donotaccess && \
    test -f /donotaccess/rewards.py && \
    test -f /donotaccess/reward_config.json && \
    test -f /donotaccess/elementwise_add_relu/grade.py && \
    test -f /donotaccess/elementwise_add_relu/reference.py && \
    test -f /donotaccess/rmsnorm/grade.py && \
    test -f /donotaccess/rmsnorm/reference.py && \
    test -f /donotaccess/softmax_rows/grade.py && \
    test -f /donotaccess/softmax_rows/reference.py && \
    su agent -c "cat /donotaccess/rewards.py" 2>&1 | grep -qE "(Permission denied|cannot open)" && \
    echo "MOAT VERIFIED: /donotaccess is root:700 and hidden from agent"

# Defense in depth for in-tree hidden files.
RUN find /app/src/protean/tasks -path '*/donotaccess' -type d -exec chmod 700 {} + && \
    find /app/src/protean/tasks -path '*/donotaccess/*' -type f -exec chmod 600 {} + && \
    chown -R root:root /app/src/protean/tasks

ENV AGENT_UID=1000 AGENT_GID=1000 HOME=/home/agent USER=agent
CMD ["python", "-c", "from protean.env import env; env.run(host='0.0.0.0', port=8765)"]
